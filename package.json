{
  "name": "oasis-editor",
  "version": "0.0.195",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/celsowm/oasis-editor.git"
  },
  "main": "./dist/oasis-editor.umd.cjs",
  "module": "./dist/oasis-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/oasis-editor.js",
      "require": "./dist/oasis-editor.umd.cjs"
    },
    "./style.css": "./dist/oasis-editor.css",
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    }
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "brand:generate": "node ./scripts/generate-brand-assets.mjs",
    "dev": "vite",
    "build:lib": "vite build --mode lib && vite build --config vite.adapters.config.js",
    "build:app": "vite build",
    "build": "npm run build:lib && npm run build:app",
    "prepack": "npm run build:lib",
    "preview": "vite preview",
    "test:perf": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:e2e": "npm run build && playwright test --config playwright.e2e.config.ts",
    "test:e2e:headed": "npm run build && playwright test --config playwright.e2e.config.ts --headed",
    "test:e2e:ui": "npm run build && playwright test --config playwright.e2e.config.ts --ui",
    "wasm:build": "wasm-pack build ./rust-core --target web --out-dir ../public/wasm",
    "dev:rust": "npm run wasm:build && vite",
    "build:all": "npm run wasm:build && npm run build",
    "test": "vitest run",
    "test:word-parity": "vitest run --config vitest.word-parity.config.js",
    "check:imports": "node ./scripts/check-import-graph.mjs",
    "check:native-ui": "node ./scripts/check-native-ui-elements.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jszip": "^3.4.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/web": "^0.0.357",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "terser": "^5.51.2",
    "ts-morph": "^28.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.1",
    "vue": "^3.5.43"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "brotli": "^1.3.3",
    "fflate": "^0.8.3",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.pt": "^0.2.1",
    "hypher": "^0.2.5",
    "jszip": "^3.10.2",
    "lucide": "^1.47.0",
    "solid-js": "^1.9.15"
  }
}
